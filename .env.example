# Settings for docker compose (copy to .env, or run get.sh, which asks and writes it).

# Your business, and how the dashboard greets you.
COMPANY_NAME=
OWNER_NAME=
COO_NAME=Juno

# The passphrase for your dashboard (8+ characters).
DASHBOARD_PASSWORD=

# Your Anthropic API key (https://console.anthropic.com). Or leave it empty and sign in with
# your Claude account once: docker compose exec -it engine claude   (then /login)
ANTHROPIC_API_KEY=
# Or connect to Steerable Cloud instead of using your own key: AI included in your plan, your
# connected accounts (Gmail, Calendar, Stripe...) and approvals. Copy both from the "Your
# server" page of your Steerable account.
STEERABLE_URL=
STEERABLE_KEY=

# The most the COO may spend on the API in a month, in USD (your own key only).
MONTHLY_BUDGET_USD=20

# Optional: which models the COO uses. "smart" does the chat and builds routines, "fast" makes
# small decisions. Empty: Sonnet and Haiku. Any model name your key's provider (or Steerable)
# knows, e.g. claude-opus-5-5.
STEERABLE_MODEL_SMART=
STEERABLE_MODEL_FAST=
# Optional: the coding agent, claude (Claude Code, the default) or opencode (needs an API key;
# build the image with --build-arg WITH_OPENCODE=1).
STEERABLE_AGENT=

# Your time zone, for the morning brief and quiet hours (e.g. Europe/London).
TZ=UTC

# The language websites see from the COO's browser when it uses your logins (e.g. en-GB, he-IL).
BROWSER_LOCALE=en-US

# Optional: Telegram (create a bot with @BotFather) and email alerts.
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_TO=

# Where the dashboard listens: this machine only (127.0.0.1), or your network (0.0.0.0).
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=3100
