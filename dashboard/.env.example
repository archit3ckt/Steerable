# Copy to .env.local. The dashboard talks to your company's agent API, so start that first:
#   cd <your company folder> && .venv/bin/python scripts/agent_api.py

# The passphrase you sign in with (8+ characters).
DASHBOARD_PASSWORD=""

# Where the agent API answers, and its token: AGENT_API_TOKEN from your company folder's .env.
AGENT_API_URL="http://127.0.0.1:8787"
AGENT_API_TOKEN=""

# How the dashboard greets you.
COMPANY_NAME=""
COO_NAME="Juno"
OWNER_NAME=""
