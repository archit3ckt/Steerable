# Copy to .env and fill in. Never commit .env.
COMPANY_NAME={{COMPANY}}
ANTHROPIC_API_KEY=

# Monthly spend cap in USD for API calls made by scripts (budget.py enforces it).
MONTHLY_BUDGET_USD=20

# Decision layer backend: haiku | jev | rules
DECIDE_BACKEND=haiku
# Jev by TypeSafe AI, a decision model (https://docs.typesafe.ai). Set DECIDE_BACKEND=jev to use it.
JEV_API_KEY=
# Optional: another endpoint (e.g. a gateway), a pinned model, and the confidence below which Haiku decides instead.
JEV_ENDPOINT=
JEV_MODEL=jev-latest
JEV_MIN_CONFIDENCE=0.6

# Alerts to yourself (scripts/alert.py). Purelymail SMTP works for this.
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_TO=

# Telegram partner channel (scripts/bridge.py). Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=

# Agent API (scripts/agent_api.py): how Steerable Cloud reads and acts on this company.
# Only needed for the hosted app. The token must match the one the app derives for this company.
AGENT_API_TOKEN=
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8787

# Backups with restic (no backup workflow ships yet). Keep a copy of the password in a password manager: without it the backups can't be opened.
RESTIC_PASSWORD=
# Off-laptop copy after `rclone config` (remote named gdrive):
RESTIC_REMOTE_REPOSITORY=
