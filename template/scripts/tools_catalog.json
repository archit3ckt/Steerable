{
  "$comment": "Services the owner can connect themselves, as official remote MCP servers that any app may sign in to (OAuth with dynamic client registration) or that take a key. Read by scripts/tools.py; the dashboard's Connections page shows them. Add one by adding an entry: its vendor's MCP address and how it signs in. Services that need an app registered by hand (Slack, HubSpot, Asana, Zoom, Google) aren't here: connect them as connectors at claude.ai, or use Steerable Cloud.",
  "stripe": {
    "name": "Stripe",
    "description": "Payments: see payments, invoices, customers and payouts.",
    "category": "Payments",
    "popular": 4,
    "uses": [
      "Chasing unpaid invoices",
      "Spotting failed payments",
      "Weekly revenue numbers"
    ],
    "auth": {
      "type": "apikey",
      "keyLabel": "Restricted key",
      "keyHint": "In Stripe, open Developers, then API keys, and create a restricted key. Give it Read access to everything, and Write access to Invoices so your COO can send payment reminders.",
      "keyPattern": "^(rk|sk)_(live|test)_[A-Za-z0-9]{10,}$",
      "header": "Authorization",
      "headerFormat": "Bearer {key}"
    },
    "mcp": {
      "url": "https://mcp.stripe.com"
    }
  },
